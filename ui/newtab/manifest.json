{
  "manifest_version": 3,
  "name": "Kestrel New Tab",
  "version": "1.3.0",
  "description": "Minimalist New Tab page for Kestrel.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
