{
  "browser_binary": "auto",
  "profile_dir": "~/.config/kestrel/profile",
  "cache_dir": "~/.cache/kestrel",
  "search_engine": "duckduckgo",
  "ram_profile": "ultra",
  "strict_security": true,
  "doh_provider": "quad9",
  "webrtc_privacy": true,
  "tab_sleeping": true,
  "hardware_accel": true,
  "widevine_drm": true,
  "adblocker": true,
  "custom_ui": true,
  "extension_support": true,
  "renderer_process_limit": 4,
  "v8_max_old_space_mb": 512,
  "widevine_path": "auto",
  "extra_flags": []
}
