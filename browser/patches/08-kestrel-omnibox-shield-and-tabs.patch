+std::atomic<bool> g_kestrel_hide_tab_search{true};
+
+void EnsureKestrelLayoutConfigInitialized() {
+  if (g_kestrel_layout_initialized.exchange(true)) {
+    return;
+  }
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::FilePath cfg_path =
+      base::GetHomeDir().Append(".config/kestrel/config.json");
+  std::string raw;
+  if (!base::ReadFileToString(cfg_path, &raw)) {
+    return;
+  }
+  auto parsed = base::JSONReader::Read(raw, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const auto& dict = parsed->GetDict();
+  if (const std::string* density = dict.FindString("tab_density")) {
+    if (*density == "compact") {
+      g_kestrel_tab_density.store(
+          static_cast<int>(KestrelTabDensity::kCompact));
+    } else if (*density == "standard") {
+      g_kestrel_tab_density.store(
+          static_cast<int>(KestrelTabDensity::kStandard));
+    } else {
+      g_kestrel_tab_density.store(static_cast<int>(KestrelTabDensity::kHelium));
+    }
+  }
+  if (std::optional<bool> hide = dict.FindBool("hide_tab_search")) {
+    g_kestrel_hide_tab_search.store(*hide);
+  }
+}
+
+}  // namespace
+
+KestrelTabDensity GetKestrelTabDensity() {
+  EnsureKestrelLayoutConfigInitialized();
+  return static_cast<KestrelTabDensity>(g_kestrel_tab_density.load());
+}
+
+void SetKestrelTabDensity(KestrelTabDensity density) {
+  g_kestrel_layout_initialized.store(true);
+  g_kestrel_tab_density.store(static_cast<int>(density));
+}
+
+bool ShouldKestrelHideTabSearch() {
+  EnsureKestrelLayoutConfigInitialized();
+  return g_kestrel_hide_tab_search.load();
+}
+
+void SetKestrelHideTabSearch(bool hide) {
+  g_kestrel_layout_initialized.store(true);
+  g_kestrel_hide_tab_search.store(hide);
+}
