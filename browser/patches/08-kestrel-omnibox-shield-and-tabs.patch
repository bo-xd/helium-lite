+void LocationBarView::OnKestrelShieldPressed() {
+  if (!profile_ || !browser_ || !kestrel_shield_button_) {
+    return;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(profile_);
+  if (!registry) {
+    return;
+  }
+  const extensions::Extension* shield_ext = nullptr;
+  for (const auto& ext : registry->enabled_extensions()) {
+    if (ext && ext->name() == "Kestrel Shield") {
+      shield_ext = ext.get();
+      break;
+    }
+  }
+  if (!shield_ext) {
+    return;
+  }
+  GURL popup_url = shield_ext->GetResourceURL("popup.html");
+  std::unique_ptr<extensions::ExtensionViewHost> host =
+      extensions::ExtensionViewHostFactory::CreatePopupHost(
+          *shield_ext, popup_url, browser_);
+  if (!host) {
+    return;
+  }
+  ExtensionPopup::ShowPopup(
+      browser_, std::move(host), views::BubbleAnchor(kestrel_shield_button_),
+      views::BubbleBorder::TOP_RIGHT, PopupShowAction::kShow,
+      base::NullCallback());
+}
 
