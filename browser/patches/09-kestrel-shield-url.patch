+
+bool HandleKestrelShieldURLRewrite(GURL* url,
+                                   content::BrowserContext* browser_context) {
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+  if (!browser_context) {
+    return false;
+  }
+  if ((url->SchemeIs("kestrel") || url->SchemeIs(content::kChromeUIScheme)) &&
+      url->GetHost() == "shield") {
+    auto* registry = extensions::ExtensionRegistry::Get(browser_context);
+    if (!registry) {
+      return false;
+    }
+    for (const auto& ext : registry->enabled_extensions()) {
+      if (ext && ext->name() == "Kestrel Shield") {
+        *url = ext->GetResourceURL("options.html");
+        return true;
+      }
+    }
+  }
+#endif
+  return false;
+}
+
+bool HandleKestrelShieldURLReverseRewrite(
+    GURL* url,
+    content::BrowserContext* browser_context) {
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+  if (!browser_context || !url->SchemeIs(extensions::kExtensionScheme)) {
+    return false;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(browser_context);
+  if (!registry) {
+    return false;
+  }
+  const extensions::Extension* ext =
+      registry->enabled_extensions().GetByID(url->GetHost());
+  if (ext && ext->name() == "Kestrel Shield" &&
+      (url->path() == "/options.html" || url->path() == "options.html")) {
+    *url = GURL("kestrel://shield");
+    return true;
+  }
+#endif
+  return false;
+}
 
