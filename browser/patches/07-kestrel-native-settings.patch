 namespace settings {
 
+class KestrelSettingsHandler : public SettingsPageUIHandler {
+ public:
+  KestrelSettingsHandler() = default;
+  ~KestrelSettingsHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "kestrelGetConfig",
+        base::BindRepeating(&KestrelSettingsHandler::HandleGetConfig,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "kestrelSetConfig",
+        base::BindRepeating(&KestrelSettingsHandler::HandleSetConfig,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "kestrelResetConfig",
+        base::BindRepeating(&KestrelSettingsHandler::HandleResetConfig,
+                            base::Unretained(this)));
+  }
+
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override {}
+
+ private:
+  static base::FilePath GetConfigPath() {
+    return base::GetHomeDir().Append(".config/kestrel/config.json");
+  }
+
+  static base::DictValue DefaultConfig() {
+    base::DictValue d;
+    d.Set("browser_binary", "auto");
+    d.Set("profile_dir", "~/.config/kestrel/profile");
+    d.Set("cache_dir", "~/.cache/kestrel");
+    d.Set("search_engine", "duckduckgo");
+    d.Set("ram_profile", "ultra");
+    d.Set("strict_security", true);
+    d.Set("doh_provider", "quad9");
+    d.Set("webrtc_privacy", true);
+    d.Set("tab_sleeping", true);
+    d.Set("hardware_accel", true);
+    d.Set("widevine_drm", true);
+    d.Set("adblocker", true);
+    d.Set("custom_ui", true);
+    d.Set("extension_support", true);
+    d.Set("renderer_process_limit", 4);
+    d.Set("v8_max_old_space_mb", 512);
+    d.Set("widevine_path", "auto");
+    d.Set("extra_flags", base::ListValue());
+    return d;
+  }
+
+  static base::DictValue LoadConfig() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::DictValue cfg = DefaultConfig();
+    std::string raw;
+    if (base::ReadFileToString(GetConfigPath(), &raw)) {
+      auto parsed = base::JSONReader::Read(raw, base::JSON_PARSE_RFC);
+      if (parsed && parsed->is_dict()) {
+        cfg.Merge(std::move(parsed->GetDict()));
+      }
+    }
+    return cfg;
+  }
+
+  static void SaveConfig(const base::DictValue& cfg) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::FilePath path = GetConfigPath();
+    base::CreateDirectory(path.DirName());
+    std::string out;
+    base::JSONWriter::WriteWithOptions(
+        cfg, base::JSONWriter::OPTIONS_PRETTY_PRINT, &out);
+    base::WriteFile(path, out);
+  }
+
+  void HandleGetConfig(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) return;
+    ResolveJavascriptCallback(args[0], LoadConfig());
+  }
+
+  void HandleSetConfig(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() < 3 || !args[1].is_string()) return;
+    const std::string& key = args[1].GetString();
+    base::DictValue cfg = LoadConfig();
+    cfg.Set(key, args[2].Clone());
+    if (key == "ram_profile" && args[2].is_string()) {
+      if (args[2].GetString() == "ultra") {
+        cfg.Set("renderer_process_limit", 4);
+        cfg.Set("v8_max_old_space_mb", 512);
+      } else {
+        cfg.Set("renderer_process_limit", 6);
+        cfg.Set("v8_max_old_space_mb", 768);
+      }
+    }
+    SaveConfig(cfg);
+    ResolveJavascriptCallback(args[0], cfg);
+  }
+
+  void HandleResetConfig(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) return;
+    base::DictValue cfg = DefaultConfig();
+    SaveConfig(cfg);
+    ResolveJavascriptCallback(args[0], cfg);
+  }
+};
